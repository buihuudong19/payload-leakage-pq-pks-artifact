{
 "version": "srnet_runs_v2",
 "registered": "2026-11-06 21:00, before any SRNet training; replaces srnet_runs_v1.json (kept for reference)",
 "common": {
  "batch_pairs": 16,
  "optimizer": {
   "name": "Adamax",
   "betas": [
    0.9,
    0.999
   ],
   "eps": 1e-08
  },
  "weight_decay_conv": 0.0002,
  "augment": "the same random rotation by k*90 degrees and flip for both images of each cover-stego pair",
  "amp": true,
  "val_every": 875,
  "monitor_every": 8750,
  "seed": 1,
  "score": "logit(stego) - logit(cover)"
 },
 "datasets": {
  "g4": {
   "dir": "results/srnet/data_g4",
   "size": 256,
   "sets": [
    "cover",
    "hill_0.4"
   ]
  },
  "confirm": {
   "dir": "results/srnet/data_confirm",
   "size": 512,
   "sets": [
    "cover",
    "a0.4_PQ-PKS",
    "a0.4_REF-U",
    "a0.2_PQ-PKS",
    "a0.2_REF-U"
   ]
  }
 },
 "runs": {
  "g4_hill_0.4": {
   "data": "g4",
   "stego": "hill_0.4",
   "init": null,
   "phases": [
    [
     400000,
     0.001
    ],
    [
     100000,
     0.0001
    ]
   ],
   "select_last": 100000,
   "train_crop": null,
   "branch_at": 200000,
   "note": "full [BCF19] schedule; run up to iteration 200000 (--until) and continued only if g4_hill_0.4_short fails G4"
  },
  "g4_hill_0.4_short": {
   "data": "g4",
   "stego": "hill_0.4",
   "init": null,
   "init_state": {
    "run": "g4_hill_0.4",
    "iter": 200000
   },
   "phases": [
    [
     200000,
     0.001
    ],
    [
     50000,
     0.0001
    ]
   ],
   "select_last": 50000,
   "train_crop": null,
   "note": "short branch: continues the iteration-200000 state of g4_hill_0.4 (model, Adamax, GradScaler), 50k iterations at lr 1e-4"
  },
  "confirm_REF-U_0.4": {
   "data": "confirm",
   "stego": "a0.4_REF-U",
   "init": "@g4_selected",
   "pair_with": "a0.4_PQ-PKS",
   "phases": [
    [
     100000,
     0.001
    ],
    [
     50000,
     0.0001
    ]
   ],
   "select_last": 50000,
   "train_crop": 256
  },
  "confirm_PQ-PKS_0.4": {
   "data": "confirm",
   "stego": "a0.4_PQ-PKS",
   "init": "@g4_selected",
   "pair_with": "a0.4_REF-U",
   "phases": [
    [
     100000,
     0.001
    ],
    [
     50000,
     0.0001
    ]
   ],
   "select_last": 50000,
   "train_crop": 256
  },
  "confirm_REF-U_0.2": {
   "data": "confirm",
   "stego": "a0.2_REF-U",
   "init": "confirm_REF-U_0.4",
   "pair_with": "a0.2_PQ-PKS",
   "phases": [
    [
     50000,
     0.001
    ],
    [
     50000,
     0.0001
    ]
   ],
   "select_last": 50000,
   "train_crop": 256
  },
  "confirm_PQ-PKS_0.2": {
   "data": "confirm",
   "stego": "a0.2_PQ-PKS",
   "init": "confirm_PQ-PKS_0.4",
   "pair_with": "a0.2_REF-U",
   "phases": [
    [
     50000,
     0.001
    ],
    [
     50000,
     0.0001
    ]
   ],
   "select_last": 50000,
   "train_crop": 256
  }
 },
 "g4_protocol": {
  "order": [
   "g4_hill_0.4_short",
   "g4_hill_0.4"
  ],
  "rule": "evaluate g4_hill_0.4_short first; if it passes (|P_E - 0.1414| <= 0.02) it is used; otherwise run g4_hill_0.4 to the end of the 500k iterations and decide G4 from that run. No reselection after both have been seen.",
  "scope": "HILL 0.4 bpp only (S-UNIWARD and 0.2 bpp dropped)"
 },
 "sequences": {
  "confirm": [
   "confirm_REF-U_0.4",
   "confirm_PQ-PKS_0.4",
   "confirm_REF-U_0.2",
   "confirm_PQ-PKS_0.2"
  ]
 },
 "confirm_requires": "G4_SRNet_pass = true in results/srnet/g4_srnet_summary.json; initialization '@g4_selected' = selected_run of that file"
}
